{
  "name": "brain-bbqs-web-components",
  "private": true,
  "description": "Common components shared across the BBQS companion web apps (clip-extractor, encoding-helper, bbqs-uploader), published as independently versioned @brain-bbqs/* packages.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b configs/tsconfig.build.json",
    "typecheck": "tsc -b configs/tsconfig.json",
    "lint": "eslint --config configs/eslint.config.js .",
    "format": "prettier --config configs/prettier.config.js --write .",
    "format:check": "prettier --config configs/prettier.config.js --check .",
    "test": "vitest run --config configs/vitest.config.ts",
    "test:watch": "vitest --config configs/vitest.config.ts",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "storybook": "npm run storybook -w @brain-bbqs/ui",
    "build-storybook": "npm run build-storybook -w @brain-bbqs/ui",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish",
    "clean": "rm -rf packages/*/dist node_modules/.tsbuild coverage"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^26.6.2",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.0",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^5.0.0"
  }
}
