{
  // The package itself is plain JavaScript with JSDoc types (so the apps' eslint/prettier configs
  // can load it with no build step); checkJs typechecks it against the hand-written .d.ts files.
  "extends": "../../configs/tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "types": ["node", "vite/client"],
    "composite": true,
    "rootDir": "../..",
    "emitDeclarationOnly": true,
    "noEmit": false,
    "declaration": true,
    "outDir": "../../node_modules/.tsbuild/config"
  },
  "include": ["*.js", "*.d.ts", "tests/**/*.ts"]
}
