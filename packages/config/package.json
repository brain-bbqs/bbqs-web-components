{
  "name": "@brain-bbqs/config",
  "version": "0.2.1",
  "description": "Shared ESLint, Prettier, TypeScript, Vite, Vitest, Playwright and Storybook configuration for the BBQS companion web apps.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brain-bbqs/bbqs-web-components.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/brain-bbqs/bbqs-web-components/tree/main/packages/config#readme",
  "files": [
    "*.js",
    "*.d.ts",
    "tsconfig.base.json",
    "README.md"
  ],
  "exports": {
    "./eslint": {
      "types": "./eslint.d.ts",
      "default": "./eslint.js"
    },
    "./prettier": {
      "types": "./prettier.d.ts",
      "default": "./prettier.js"
    },
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./vite": {
      "types": "./vite.d.ts",
      "default": "./vite.js"
    },
    "./vitest": {
      "types": "./vitest.d.ts",
      "default": "./vitest.js"
    },
    "./playwright": {
      "types": "./playwright.d.ts",
      "default": "./playwright.js"
    },
    "./storybook": {
      "types": "./storybook.d.ts",
      "default": "./storybook.js"
    },
    "./storybook-preview": {
      "types": "./storybook-preview.d.ts",
      "default": "./storybook-preview.js"
    },
    "./app-version": {
      "types": "./app-version.d.ts",
      "default": "./app-version.js"
    },
    "./pre-paint": {
      "types": "./pre-paint.d.ts",
      "default": "./pre-paint.js"
    }
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@eslint/js": "^9.39.0 || ^10.0.0",
    "@playwright/test": "^1.48.0",
    "@storybook/html-vite": "^10.0.0",
    "eslint": "^9.39.0 || ^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "@storybook/html-vite": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/html-vite": "^10.5.3",
    "storybook": "^10.5.3"
  }
}
