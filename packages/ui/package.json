{
  "name": "@brain-bbqs/ui",
  "version": "0.1.0",
  "description": "The shared page shell of the BBQS companion web apps: theme tokens and toggle, header account menu, brand watermarks and footer, human-subjects gate, dropzone, and typed element lookups. Plain DOM, no framework.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brain-bbqs/brain-bbqs-web-components.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/brain-bbqs/brain-bbqs-web-components/tree/main/packages/ui#readme",
  "files": [
    "dist",
    "styles",
    "html",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./styles/*",
    "./html/*": "./html/*"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json",
    "storybook": "storybook dev -p 6006 --config-dir storybook",
    "build-storybook": "storybook build --config-dir storybook"
  },
  "dependencies": {
    "@brain-bbqs/utils": "^0.1.0"
  },
  "devDependencies": {
    "@brain-bbqs/config": "^0.2.0",
    "@storybook/html-vite": "^10.5.3",
    "storybook": "^10.5.3"
  }
}
