{
  "name": "@brain-bbqs/ember-client",
  "version": "0.1.0",
  "description": "Browser client for the EMBER (DANDI) archive as the BBQS companion apps use it: PKCE sign-in, bearer-authenticated API calls, the Incoming dataset picker, the human-subjects gate, dandi-etag hashing, and persisted settings.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brain-bbqs/brain-bbqs-web-components.git",
    "directory": "packages/ember-client"
  },
  "homepage": "https://github.com/brain-bbqs/brain-bbqs-web-components/tree/main/packages/ember-client#readme",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@brain-bbqs/utils": "^0.1.0",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@types/spark-md5": "^3.0.5"
  }
}
