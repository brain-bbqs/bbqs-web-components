{
  // Monorepo-only layer over the published base: the `paths` below point each @brain-bbqs/*
  // import at its sibling package's TypeScript source, so typecheck, lint and tests never need a
  // built dist/ first. The apps extend @brain-bbqs/config/tsconfig.base.json directly and resolve
  // the packages from node_modules like any other dependency.
  "extends": "../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@brain-bbqs/utils": ["../packages/utils/src/index.ts"],
      "@brain-bbqs/ember-client": ["../packages/ember-client/src/index.ts"],
      "@brain-bbqs/ui": ["../packages/ui/src/index.ts"],
      "@brain-bbqs/test-utils/playwright": ["../packages/test-utils/src/playwright/index.ts"],
      "@brain-bbqs/test-utils/vitest": ["../packages/test-utils/src/vitest/index.ts"],
      "@brain-bbqs/config/*": ["../packages/config/*"]
    }
  }
}
